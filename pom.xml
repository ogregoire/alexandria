<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>be.imgn.alexandria</groupId>
  <artifactId>parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Alexandria</name>
  <description>Personal book management system modelled on IFLA FRBR/LRM (Work-Expression-Manifestation-Item)</description>

  <modules>
    <module>app</module>
    <module>alexandria-maven-plugin</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <jackson.version>2.18.2</jackson.version>
    <junit.version>5.11.4</junit.version>
    <assertj.version>3.27.3</assertj.version>

    <maven.api.version>3.9.9</maven.api.version>
    <maven.plugin.tools.version>3.15.2</maven.plugin.tools.version>
    <!-- maven-plugin-plugin ships an ASM that predates Java 25 bytecode (major 69) and
         chokes while scanning our own classes; overriding it is the whole fix. -->
    <asm.version>9.10.1</asm.version>
    <maven.reporting.version>4.0.0</maven.reporting.version>

    <versions-plugin.version>2.21.0</versions-plugin.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <checkstyle.version>13.4.2</checkstyle.version>
    <spotless-plugin.version>3.5.1</spotless-plugin.version>
    <palantir-java-format.version>2.83.0</palantir-java-format.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>be.imgn.alexandria</groupId>
        <artifactId>alexandria</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!--
        The app is launched with exec:java, so it runs on whichever JVM Maven itself is
        running on. Checking that here rather than relying on maven.compiler.release means
        a too-old JDK fails at the start of the build instead of at the first `./alexandria`.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>require-java-25</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[${maven.compiler.release},)</version>
                  <message>Alexandria needs Maven to run on Java ${maven.compiler.release} or newer. Point JAVA_HOME at a matching JDK.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Formatting first, then the style check, both in `validate`. Declared in this order on
        purpose: spotless rewrites the source and checkstyle then judges what spotless left,
        so the two can never disagree about the same file in one build.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.6.3</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-plugin-plugin</artifactId>
          <version>${maven.plugin.tools.version}</version>
        </plugin>
        <plugin>
          <groupId>be.imgn.alexandria</groupId>
          <artifactId>alexandria-maven-plugin</artifactId>
          <version>${project.version}</version>
        </plugin>

        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless-plugin.version}</version>
          <configuration>
            <java>
              <excludes>
                <exclude>**/module-info.java</exclude>
                <exclude>**/package-info.java</exclude>
              </excludes>
              <palantirJavaFormat>
                <version>${palantir-java-format.version}</version>
                <style>PALANTIR</style>
                <formatJavadoc>true</formatJavadoc>
              </palantirJavaFormat>
              <removeUnusedImports/>
              <!--
                  java|javax groups the two into a single import block (no blank
                  line between them); the trailing comma is the "everything else"
                  group. Keep this in sync with checkstyle's import expectations.
              -->
              <importOrder>
                <order>java|javax,com,org,</order>
              </importOrder>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </java>
          </configuration>
          <executions>
            <execution>
              <id>spotless-apply</id>
              <phase>validate</phase>
              <goals>
                <goal>apply</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${maven-checkstyle-plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <configLocation>checkstyle.xml</configLocation>
            <consoleOutput>true</consoleOutput>
            <failsOnError>true</failsOnError>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
          </configuration>
          <executions>
            <execution>
              <id>validate</id>
              <phase>validate</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!--
          Only ever invoked by hand: `./mvnw versions:display-dependency-updates` and
          `versions:display-plugin-updates`. The rules keep the answer to "what can I
          upgrade?" free of snapshots, milestones, release candidates and previews, which
          otherwise bury the stable releases.
        -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>${versions-plugin.version}</version>
          <configuration>
            <ruleSet>
              <ignoreVersions>
                <!--
                  Exclude snapshots, milestones, release candidates.

                  Two deviations from the recipe this came from, each found by an upgrade
                  that got through: Jackson publishes "3.0-rc5" in lower case, so the
                  pattern is case-insensitive; and Maven publishes "4.0.0-rc-5", so the
                  digits may be separated from the qualifier.
                -->
                <ignoreVersion>
                  <type>regex</type>
                  <version>(?i).+-(SNAPSHOT|M[-.]?\d+|RC[-.]?\d+|CR[-.]?\d+|PRE[-.]?\d*|preview.*)</version>
                </ignoreVersion>
                <!-- Exclude alpha/beta versions, with or without a trailing qualifier -->
                <ignoreVersion>
                  <type>regex</type>
                  <version>(?i).+-(alpha|beta).*</version>
                </ignoreVersion>
              </ignoreVersions>
            </ruleSet>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <!--
    There is deliberately no <reporting> section and no maven-site-plugin.

    The catalogue used to be a MavenReport, and being one cost more than it gave: Maven
    surrounds reports with a report index, a skin and a set of project-information pages, and
    all of that ended up in front of the library instead of being part of it. It is now a
    plain mojo, published with

        ./mvnw install -DskipTests
        ./mvnw alexandria:catalog

    which writes only the catalogue into target/site. It cannot be bound to a lifecycle phase
    here: the plugin depends on the alexandria module, so declaring it as a build plugin in
    this reactor is a cycle Maven refuses. Hence the two commands, and hence the pluginManagement
    entry above, which is only there to pin the version for that invocation.
  -->
</project>
